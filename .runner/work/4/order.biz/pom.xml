<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.mware</groupId>
        <artifactId>order</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>order.biz</artifactId>
    <name>order.biz</name>
    <description>业务逻辑</description>

    <dependencies>
        <!-- @Service / @Transactional 等注解：之前由共享库传递引入，现显式声明 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mware</groupId>
            <artifactId>order.domain</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mware</groupId>
            <artifactId>order.dto</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mware</groupId>
            <artifactId>order.mapper</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mware</groupId>
            <artifactId>order.feign</artifactId>
        </dependency>
        <!-- 错误码 / ApiException（base.web 提供） -->
        <dependency>
            <groupId>com.mware</groupId>
            <artifactId>base.web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Seata AT（@GlobalTransactional）：
             用 SCA 2023.x 的新坐标，版本由父 POM 的 spring-cloud-alibaba-dependencies BOM 管理（2023.0.3.2）。
             旧坐标 spring-cloud-alibaba-seata 已停止发布（SCA 2.2.x 后改名），且其 2.1.0.RELEASE 面向 Spring Boot 2。 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-seata</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
    </dependencies>
</project>
