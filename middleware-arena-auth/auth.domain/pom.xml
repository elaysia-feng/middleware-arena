<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.mware</groupId>
        <artifactId>auth</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>auth.domain</artifactId>
    <name>auth.domain</name>
    <description>MySQL 实体 / 领域对象</description>

    <dependencies>
        <!-- 仅注解依赖，避免把 jdbc 带入应用模块 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-annotation</artifactId>
        </dependency>
        <!-- @Schema 实体文档注解：轻量，只含注解；版本由 ma-parent 管理（2.2.22，与 springdoc 2.6.0 配套）。
             不要用 springdoc-openapi-starter-webmvc-ui —— 会把整个 UI starter 拖进 domain，且 2.8.x 需要 Boot 3.4+ -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations-jakarta</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
