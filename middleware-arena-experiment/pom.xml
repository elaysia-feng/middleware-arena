<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.mware</groupId>
        <artifactId>ma-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>experiment</artifactId>
    <packaging>pom</packaging>
    <name>experiment</name>
    <description>实验服务：实验模板 / 版本快照 / 任务状态机 / SSE 进度推送</description>

    <modules>
        <module>experiment.web</module>
        <module>experiment.biz</module>
        <module>experiment.config</module>
        <module>experiment.mq</module>
        <module>experiment.domain</module>
        <module>experiment.dto</module>
        <module>experiment.mapper</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.mware</groupId>
                <artifactId>experiment.web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mware</groupId>
                <artifactId>experiment.biz</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mware</groupId>
                <artifactId>experiment.config</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mware</groupId>
                <artifactId>experiment.mq</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mware</groupId>
                <artifactId>experiment.domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mware</groupId>
                <artifactId>experiment.dto</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mware</groupId>
                <artifactId>experiment.mapper</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- RabbitMQ：BOM(ma-parent) 把 spring-rabbit/spring-amqp 管理到 3.1.7，本地离线仓库缺失；
                 在本服务 dependencyManagement 钉住离线可用的 3.1.4（同 Boot 3.3 线，API 兼容），
                 子模块管理优先于父 BOM，避免 web/biz 传递依赖解析 3.1.7 失败（community 同款处理） -->
            <dependency>
                <groupId>org.springframework.amqp</groupId>
                <artifactId>spring-rabbit</artifactId>
                <version>3.1.4</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.amqp</groupId>
                <artifactId>spring-amqp</artifactId>
                <version>3.1.4</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
