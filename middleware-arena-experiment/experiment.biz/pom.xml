<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.mware</groupId>
        <artifactId>experiment</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>experiment.biz</artifactId>
    <name>experiment.biz</name>
    <description>实验业务逻辑</description>

    <dependencies>
        <!-- @Service / @Transactional 等注解：之前由共享库传递引入，现显式声明 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mware</groupId>
            <artifactId>experiment.domain</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mware</groupId>
            <artifactId>experiment.dto</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mware</groupId>
            <artifactId>experiment.mapper</artifactId>
        </dependency>
        <!-- MQ 消息契约 + 生产端（RunnerTaskMessage / RunnerTaskProducer）：createTask 投递用；
             传递引入 experiment.config（拓扑 / RabbitTemplate） -->
        <dependency>
            <groupId>com.mware</groupId>
            <artifactId>experiment.mq</artifactId>
        </dependency>
        <!-- 错误码 / ApiException（base.web 提供） -->
        <dependency>
            <groupId>com.mware</groupId>
            <artifactId>base.web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- 阿里云 OSS：版本文件快照上传、下载与删除 -->
        <dependency>
            <groupId>com.aliyun.oss</groupId>
            <artifactId>aliyun-sdk-oss</artifactId>
            <version>3.18.4</version>
        </dependency>
        <!-- Java 9+ 使用 OSS Java SDK V1 所需的 JAXB 依赖 -->
        <dependency>
            <groupId>javax.xml.bind</groupId>
            <artifactId>jaxb-api</artifactId>
            <version>2.3.1</version>
        </dependency>
        <dependency>
            <groupId>javax.activation</groupId>
            <artifactId>activation</artifactId>
            <version>1.1.1</version>
        </dependency>
        <dependency>
            <groupId>org.glassfish.jaxb</groupId>
            <artifactId>jaxb-runtime</artifactId>
            <version>2.3.3</version>
        </dependency>
    </dependencies>
</project>
