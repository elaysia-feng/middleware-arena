# ==================== LLM ====================
OPENAI_API_BASE=https://api.deepseek.com
OPENAI_API_KEY=sk-xxxx
OPENAI_MODEL=deepseek-v4-flash

# ==================== Langfuse ====================
LANGFUSE_PUBLIC_KEY=pk-lf-xxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxx
LANGFUSE_HOST=http://127.0.0.1:3000

# ==================== RabbitMQ ====================
# 与 experiment-service / runner-service application.yml 保持同一套环境变量名和默认地址。
RABBIT_HOST=192.168.0.192
RABBIT_PORT=5672
RABBIT_USER=guest
RABBIT_PASSWORD=guest

# ==================== Java internal APIs ====================
# Agent 收到 MQ 后只拿 task/version 等 ID，再通过内部 HTTP 拉取 metrics/code diff/logs。
EXPERIMENT_SERVICE_URL=http://127.0.0.1:9003
MA_INTERNAL_TOKEN=middleware-arena-internal-token

# ==================== Agent ====================
AGENT_HTTP_PREFIX=/agent
AGENT_MAX_ANALYSIS_ITERATIONS=3
AGENT_MQ_PREFETCH=1
AGENT_MQ_MAX_ATTEMPTS=3
