# Middleware Arena Agent 开发默认配置。
# 这里只提交非敏感默认值；真实 OPENAI / Langfuse 密钥请写到 .env.local（已被 gitignore）。

# ==================== Agent ====================
AGENT_HOST=0.0.0.0
AGENT_PORT=9500
AGENT_HTTP_PREFIX=/agent
AGENT_MAX_ANALYSIS_ITERATIONS=3
AGENT_PATCH_CONFIDENCE_THRESHOLD=0.75

# 核心 LangGraph 逻辑还未完成前默认关闭 MQ consumer；完成 run_analysis 后改为 true。
AGENT_MQ_ENABLED=false
AGENT_MQ_PREFETCH=1
AGENT_MQ_MAX_ATTEMPTS=3
AGENT_MQ_RETRY_INTERVAL_SECONDS=1.0

# ==================== RabbitMQ ====================
# 与 experiment-service / runner-service application.yml 对齐。
RABBIT_HOST=192.168.0.192
RABBIT_PORT=5672
RABBIT_USER=guest
RABBIT_PASSWORD=guest
RABBIT_VHOST=/

# ==================== Java internal APIs ====================
EXPERIMENT_SERVICE_URL=http://127.0.0.1:9003
MA_INTERNAL_TOKEN=middleware-arena-internal-token
INTERNAL_TOKEN_HEADER=X-Internal-Token
INTERNAL_HTTP_TIMEOUT_SECONDS=10

# ==================== LLM ====================
ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=MiniMax-M3[1m]

# ==================== Langfuse ====================
LANGFUSE_SECRET_KEY="sk-lf-d460f69f-adea-4421-9d6c-3c0cdbac24c7"
LANGFUSE_PUBLIC_KEY="pk-lf-05196c66-e801-4ff4-8d91-5656e10da279"
LANGFUSE_BASE_URL="https://us.cloud.langfuse.com"
LANGFUSE_TRACING_ENVIRONMENT=development
