# Python bytecode / runtime cache
__pycache__/
*.py[cod]
*$py.class

# Test / type-check / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.hypothesis/
.coverage
.coverage.*
htmlcov/

# Packaging / build artifacts
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Local application cache
.cache/

# Local secrets / developer overrides
# .env 只保存可公开的开发默认值；真实密钥放 .env.local。
.env.local

# IDE / OS generated files
.idea/
.vscode/
.DS_Store
Thumbs.db
