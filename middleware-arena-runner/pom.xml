<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.mware</groupId>
        <artifactId>ma-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>runner</artifactId>
    <packaging>pom</packaging>
    <name>runner</name>
    <description>Runner 服务：拉取任务 → 构建 → 起容器 → k6 压测 → 采指标 → 清理流水线</description>

    <modules>
        <module>runner.web</module>
        <module>runner.biz</module>
        <module>runner.dto</module>
        <module>runner.test</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.mware</groupId>
                <artifactId>runner.web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mware</groupId>
                <artifactId>runner.biz</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mware</groupId>
                <artifactId>runner.dto</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- RabbitMQ：BOM(ma-parent) 把 spring-rabbit / spring-amqp 钉到 3.1.7，本地离线仓库缺失；
                 在本服务 dependencyManagement 钉住离线可用的 3.1.4（同 Boot 3.3 线，API 兼容），
                 避免 web/biz 传递依赖解析 3.1.7 失败（experiment / community 同款处理） -->
            <dependency>
                <groupId>org.springframework.amqp</groupId>
                <artifactId>spring-rabbit</artifactId>
                <version>3.1.4</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.amqp</groupId>
                <artifactId>spring-amqp</artifactId>
                <version>3.1.4</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
