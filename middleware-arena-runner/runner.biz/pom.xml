<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.mware</groupId>
        <artifactId>runner</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>runner.biz</artifactId>
    <name>runner.biz</name>
    <description>Runner 业务逻辑</description>

    <dependencies>
        <!-- @Service / @Transactional 等注解：之前由共享库传递引入，现显式声明 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mware</groupId>
            <artifactId>runner.dto</artifactId>
        </dependency>
        <!-- 错误码 / ApiException（base.web 提供） -->
        <dependency>
            <groupId>com.mware</groupId>
            <artifactId>base.web</artifactId>
        </dependency>
        <!-- RabbitMQ：runner 消费 experiment.service 投递的 RunnerTaskMessage（@RabbitListener / @EnableRabbit）
             用 spring-rabbit 而非 spring-boot-starter-amqp：starter 3.3.5 不在本地离线仓库，
             直接引 spring-rabbit（版本由 runner 根 pom dependencyManagement 钉住 3.1.4，离线可编译）。 -->
        <dependency>
            <groupId>org.springframework.amqp</groupId>
            <artifactId>spring-rabbit</artifactId>
        </dependency>
        <!-- JSON：Jackson2JsonMessageConverter 自动配置 / RunnerTaskMessage 反序列化 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- Redis：任务实例状态缓存（T3 基础设施，T4/T5 使用 RunnerRedisKeys 键名读写） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- 阿里云 OSS：按消息中的对象 Key 下载版本文件快照 -->
        <dependency>
            <groupId>com.aliyun.oss</groupId>
            <artifactId>aliyun-sdk-oss</artifactId>
            <version>3.18.4</version>
        </dependency>
        <!-- Java 9+ 使用 OSS Java SDK V1 所需的 JAXB 依赖 -->
        <dependency>
            <groupId>javax.xml.bind</groupId>
            <artifactId>jaxb-api</artifactId>
            <version>2.3.1</version>
        </dependency>
        <dependency>
            <groupId>javax.activation</groupId>
            <artifactId>activation</artifactId>
            <version>1.1.1</version>
        </dependency>
        <dependency>
            <groupId>org.glassfish.jaxb</groupId>
            <artifactId>jaxb-runtime</artifactId>
            <version>2.3.3</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
