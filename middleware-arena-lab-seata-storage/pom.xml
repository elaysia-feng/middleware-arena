    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.mware</groupId>
                <artifactId>storage.web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mware</groupId>
                <artifactId>storage.biz</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mware</groupId>
                <artifactId>storage.domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mware</groupId>
                <artifactId>storage.dto</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mware</groupId>
                <artifactId>storage.mapper</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
