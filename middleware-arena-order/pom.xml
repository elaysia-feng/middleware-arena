    <!-- 内部模块版本管理：子模块之间可无版本引用 -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.mware</groupId>
                <artifactId>order.web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mware</groupId>
                <artifactId>order.biz</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mware</groupId>
                <artifactId>order.domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mware</groupId>
                <artifactId>order.dto</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mware</groupId>
                <artifactId>order.mapper</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mware</groupId>
                <artifactId>order.feign</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mware</groupId>
                <artifactId>order.config</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
