<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.mware</groupId>
        <artifactId>ma-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>community</artifactId>
    <packaging>pom</packaging>
    <name>community</name>
    <description>社区服务：帖子 CRUD / 评论 / 点赞 / 收藏 / 关注 / ES 全文搜索</description>

    <modules>
        <module>community.web</module>
        <module>community.biz</module>
        <module>community.domain</module>
        <module>community.dto</module>
        <module>community.mapper</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- RabbitMQ：BOM(ma-parent) 把 spring-rabbit/spring-amqp 管理到 3.1.7，本地离线仓库缺失；
                 在本服务 dependencyManagement 钉住离线可用的 3.1.4（同 Boot 3.3 线，API 兼容），
                 子模块管理优先于父 BOM，避免 web 传递依赖解析 3.1.7 失败 -->
            <dependency>
                <groupId>org.springframework.amqp</groupId>
                <artifactId>spring-rabbit</artifactId>
                <version>3.1.4</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.amqp</groupId>
                <artifactId>spring-amqp</artifactId>
                <version>3.1.4</version>
            </dependency>
            <dependency>
                <groupId>com.mware</groupId>
                <artifactId>community.web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mware</groupId>
                <artifactId>community.biz</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mware</groupId>
                <artifactId>community.domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mware</groupId>
                <artifactId>community.dto</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mware</groupId>
                <artifactId>community.mapper</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
